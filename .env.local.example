# Kopiere diese Datei nach .env.local und trage deine Keys ein.
# .env.local wird nicht ins Git eingecheckt und nie an den Browser geschickt.
# Nach Änderungen den Dev-Server neu starten.

# KI-Anbieter: "gemma" (Standard, Google-API), "anthropic" (Claude, schnell) oder "ollama" (lokal)
AI_PROVIDER=gemma

# Gemma über die Google Gemini API
GEMMA_API_KEY=
# Optional: GEMMA_THINKING=default   (Standard ist "minimal" = etwa doppelt so schnell)

# Claude (für AI_PROVIDER=anthropic). Schnell: claude-haiku-5-5 oder claude-sonnet-5-5
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=low

# Ollama lokal (vorher: ollama pull gemma4:12b)
# OLLAMA_MODEL=gemma4:12b

# Demo-Mails (SMTP). Ohne diese Angaben gehen Demo-Mails an einen Test-Mailserver mit Vorschau-Link.
# Beispiele: Gmail smtp.gmail.com:465 (App-Passwort), GMX mail.gmx.net:587, Web.de smtp.web.de:587, Outlook smtp-mail.outlook.com:587
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Claim Mate <deine@adresse.de>

# Sprache (ElevenLabs): Mikrofon-Eingabe und Vorlesen der Antworten
# ELEVENLABS_API_KEY=
# Optional: feste Stimme (Voice ID aus der ElevenLabs Voice Library), sonst automatisch eine deutschsprachige
# ELEVENLABS_VOICE_ID=
